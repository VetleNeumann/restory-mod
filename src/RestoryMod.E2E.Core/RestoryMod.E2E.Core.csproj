       judges what it sees against the mod's pure rules in RestoryMod.Core (the look table). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>RestoryMod.E2E</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RestoryMod.Core\RestoryMod.Core.csproj" />
  </ItemGroup>
</Project>
