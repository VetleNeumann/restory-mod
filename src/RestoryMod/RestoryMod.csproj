<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>RestoryMod</AssemblyName>
    <RootNamespace>RestoryMod</RootNamespace>
    <BepInExPluginGuid>com.zantox.restorymod</BepInExPluginGuid>
    <Product>RestoryMod</Product>
    <Version>0.1.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.*" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
    <PackageReference Include="UnityEngine.Modules" Version="6000.3.10" IncludeAssets="compile" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../RestoryMod.Core/RestoryMod.Core.csproj" />
  </ItemGroup>

  <!-- Game assemblies come from the local install (see GamePaths.props). Never copied or committed. -->
  <ItemGroup Condition="'$(GameManaged)' != ''">
    <Reference Include="Restory.Assembly" HintPath="$(GameManaged)/Restory.Assembly.dll" Private="false" />
    <Reference Include="Rewired_Core" HintPath="$(GameManaged)/Rewired_Core.dll" Private="false" />
    <Reference Include="RewiredAssembly" HintPath="$(GameManaged)/RewiredAssembly.dll" Private="false" />
    <Reference Include="Zenject" HintPath="$(GameManaged)/Zenject.dll" Private="false" />
    <Reference Include="Zenject-usage" HintPath="$(GameManaged)/Zenject-usage.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(GameManaged)/UnityEngine.UI.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(GameManaged)/Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="EPO" HintPath="$(GameManaged)/EPO.dll" Private="false" />
    <Reference Include="DOTween" HintPath="$(GameManaged)/DOTween.dll" Private="false" />
    <Reference Include="Sirenix.Serialization" HintPath="$(GameManaged)/Sirenix.Serialization.dll" Private="false" />
    <Reference Include="com.rlabrecque.steamworks.net" HintPath="$(GameManaged)/com.rlabrecque.steamworks.net.dll" Private="false" />
  </ItemGroup>

  <Target Name="RequireGameDir" BeforeTargets="ResolveAssemblyReferences" Condition="'$(GameManaged)' == '' Or !Exists('$(GameManaged)/Restory.Assembly.dll')">
    <Error Text="RestoryMod needs the game's assemblies. Copy GamePaths.props.example to GamePaths.props and set GameDir to your ReStory install." />
  </Target>
</Project>
